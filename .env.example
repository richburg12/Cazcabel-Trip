# The secret link: the album lives at https://<your-domain>/<ALBUM_TOKEN>
# Use something long and random, e.g. node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ALBUM_TOKEN=
# Lets you delete any photo (entered under the profile button → Admin)
ADMIN_CODE=
# Optional: signs the cookies. Derived from the two above if unset.
SESSION_SECRET=
# Optional: header text. Default "The Cazcabel Trip"
NEXT_PUBLIC_TRIP_NAME=
# Optional: scene tags (Distillery, Food & drink, ...) via Claude. Off when unset.
ANTHROPIC_API_KEY=
# Optional: how strict Find me is (lower = stricter). Default 0.55
FACE_THRESHOLD=

# Set automatically by the Vercel Blob and Vercel Postgres (Neon) integrations:
# BLOB_READ_WRITE_TOKEN, POSTGRES_URL
